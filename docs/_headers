# Cloudflare Pages response headers (GitHub Pages ignores this file).
# Headers from every matching rule are merged, so each path gets Cache-Control from exactly one rule.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.github.com; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'; upgrade-insecure-requests

# The page itself: always revalidate, so a new deploy shows up straight away.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Scripts, styles, fonts and art. index.html links them with a ?v= stamp, so a deploy that changes them
# bumps the stamp and browsers fetch the new files at once.
/site/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# Screenshots are replaced in place when the app changes.
/screenshots/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
# In-app announcements: always revalidate so a pushed announcement reaches the app within its next check.
/announcements.json
  Cache-Control: public, max-age=0, must-revalidate
